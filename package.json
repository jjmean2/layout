{
  "name": "layout",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:package": "turbo run lint:package",
    "e2e": "turbo run e2e",
    "e2e:dev": "turbo run e2e:dev",
    "dev": "turbo run dev --filter=playground",
    "showcase": "turbo run dev --filter=showcase",
    "storybook": "turbo run dev --filter=storybook",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/eslint-parser": "8.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11"
  }
}
