{
  "name": "layout",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @layout/react build && pnpm --filter playground build",
    "typecheck": "pnpm --filter @layout/react typecheck && pnpm --filter @layout/react build && pnpm --filter playground typecheck",
    "test": "pnpm --filter @layout/react test",
    "e2e": "pnpm build && pnpm --filter playground e2e",
    "dev": "pnpm --filter @layout/react build && pnpm --filter playground dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
