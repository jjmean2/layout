{
  "name": "@justwonder/layout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./side-panels": {
      "types": "./dist/side-panels/index.d.ts",
      "default": "./dist/side-panels/index.js"
    },
    "./tiling": {
      "types": "./dist/tiling/index.d.ts",
      "default": "./dist/tiling/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjmean2/layout.git",
    "directory": "packages/layout"
  },
  "homepage": "https://github.com/jjmean2/layout#readme",
  "bugs": {
    "url": "https://github.com/jjmean2/layout/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  }
}
