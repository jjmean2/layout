{
  "name": "@justwonder/layout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./side-panels": {
      "types": "./dist/side-panels/index.d.ts",
      "default": "./dist/side-panels/index.js"
    },
    "./tiling": {
      "types": "./dist/tiling/index.d.ts",
      "default": "./dist/tiling/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/check-directives.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
